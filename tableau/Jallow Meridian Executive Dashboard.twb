      <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_2424190324527105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ProfitAmount]) / SUM([SalesAmount])' />
