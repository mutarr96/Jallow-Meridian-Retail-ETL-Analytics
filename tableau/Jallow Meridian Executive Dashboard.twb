      <column-instance column='[SourceSystem]' derivation='None' name='[none:SourceSystem:nk]' pivot='key' type='nominal' />
      <column-instance column='[ProfitAmount]' derivation='Sum' name='[sum:ProfitAmount:qk]' pivot='key' type='quantitative' />
      <column-instance column='[SalesAmount]' derivation='Sum' name='[sum:SalesAmount:qk]' pivot='key' type='quantitative' />
